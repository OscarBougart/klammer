{
  "expo": {
    "name": "Klammer",
    "slug": "klammer",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "klammer",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#1B2430",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carbonelk.klammer"
    },
    "android": {
      "package": "com.carbonelk.klammer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#1B2430"
      },
      "permissions": [],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B2430"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2981b4e-9d99-4894-851a-1d0bd3071507"
      }
    },
    "owner": "bougart"
  }
}
