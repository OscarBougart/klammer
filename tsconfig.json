{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/board/*": [
        "./src/board/*"
      ],
      "@/engine/*": [
        "./src/engine/*"
      ],
      "@/content/*": [
        "./src/content/*"
      ],
      "@/store/*": [
        "./src/store/*"
      ],
      "@/theme": [
        "./src/theme"
      ],
      "@/theme/*": [
        "./src/theme/*"
      ],
      "@/db/*": [
        "./src/db/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/utils/*": [
        "./utils/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
